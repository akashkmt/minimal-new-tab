{
  "manifest_version": 3,
  "name": "Minimal > New Tab",
  "version": "1.0.0",
  "description": "Minimal New Tab Design",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "geolocation"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
